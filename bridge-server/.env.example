# GemMCP Bridge Server Configuration
PORT=3000

# Optional: Shared authentication token for securing bridge requests
# BRIDGE_AUTH_TOKEN=your_secure_random_token_here

# Supabase Vault (Optional: If using Supabase to store dynamic secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OAuth App Credentials (Local fallback or primary configuration)
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

SUPABASE_CLIENT_ID=your_supabase_client_id
SUPABASE_CLIENT_SECRET=your_supabase_client_secret
