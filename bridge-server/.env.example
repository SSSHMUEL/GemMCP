# GemMCP Bridge Server Configuration
# העתק את הקובץ הזה ל-.env באותה תיקייה, וערוך לפי הצורך.

PORT=3000

# ---------------------------------------------------------------------------
# הרשאות Windows - תקרה, לא ברירת מחדל.
#
# מה שמוגדר כאן הוא הגבול העליון. התוסף יכול רק לצמצם אותו, לעולם לא להרחיב:
# בקשה שמנסה להעניק לעצמה הרשאה שכבויה כאן פשוט נדחית. לכן זו ההגנה
# האמיתית, ולא מתג בתוסף.
#
# (בגרסאות מוקדמות זה לא היה כך, וגוף הבקשה כן יכול היה לדרוס את ההגדרות
# האלה. זה תוקן, וקובץ הדוגמה הזה עודכן בהתאם.)
# ---------------------------------------------------------------------------
WIN_PERM_READ=true
WIN_PERM_WRITE=false
WIN_PERM_COMMANDS=false
WIN_PERM_APPS=true
WIN_PERM_CLIPBOARD=true

# הורדה והרצה של קובץ מהאינטרנט.
#
# הבקרה בפועל היא תיבת הסימון בפופאפ של התוסף, והיא כבויה כברירת מחדל.
# השורה כאן היא מתג השבתה מוחלט: WIN_PERM_INSTALL=false חוסם את הפעולה
# בשרת בלי קשר למה שמסומן בתוסף.
#
# גם כשהיא דלוקה היא תמיד עוצרת לאישור, ואפשר לבטל מהפאנל - ביטול עוצר
# את המתקין ומוחק את מה שהורד.
# WIN_PERM_INSTALL=false

# הנתיב שבתוכו מותר לשנות דברים: כתיבה, יצירה, העברה ומחיקה.
# ריק או לא מוגדר = שולחן העבודה (ברירת מחדל שמרנית).
# כדי לפתוח את כל הדיסק לשינויים צריך להצהיר במפורש: WIN_ALLOWED_PATH=*
WIN_ALLOWED_PATH=C:\Users\YOUR_NAME\Desktop

# תקרת הקריאה, בנפרד מהכתיבה.
#
# קריאה היא פעולה הפיכה ומחיקה אינה, ולכן אין סיבה שהאחת תגרור את השנייה.
# ברירת המחדל '*' מתירה קריאה מכל מקום, והצמצום בפועל נעשה מהפופאפ של
# התוסף: שולחן העבודה, תיקיית המשתמש, או כל המחשב. גם כאן התוסף יכול רק
# לצמצם את מה שמוגדר פה.
#
# ללא תלות בהגדרה הזו, אלה חסומים תמיד: Windows, Program Files,
# ProgramData, סל המיחזור, AppData ו-.ssh.
WIN_READ_PATH=*

# תקרת גודל להורדה ולהתקנה, בבתים. ברירת מחדל 200MB / 500MB בהתאמה.
# WIN_DOWNLOAD_MAX_BYTES=209715200

# תקרת זמן לתוכנית רב-שלבית, במילישניות. ברירת מחדל 120000.
# בלעדיה 40 שלבים כפול פסק-זמן לפקודה נותנים עשרים דקות שבהן הגשר תפוס.
# WIN_PLAN_DEADLINE_MS=120000

# גודל שממנו יומן הביקורת מסתובב, בבתים. ברירת מחדל 5MB.
# WIN_AUDIT_MAX_BYTES=5242880

# שאילתות כתיבה ל-Supabase. ברירת המחדל היא קריאה בלבד.
SUPABASE_ALLOW_WRITES=false

# Token אימות הגשר - אופציונלי.
#
# כברירת מחדל האימות כבוי והכל עובד בלי שלב ידני. הסיבה: ב-Windows ה-ACL של
# קובץ טוקן פתוח לכל תהליך של אותו משתמש, ולכן טוקן בקובץ אינו מונע מתהליך
# מקומי להשתמש בגשר. מה שהוא כן חוסם - דף אינטרנט - מכוסה ממילא בבדיקת ה-Origin.
#
# מי שרוצה את השכבה הנוספת: הגדר ערך כאן, והאימות ייאכף על כל בקשה. אז צריך
# להדביק את אותו ערך גם בשדה "טוקן אימות הגשר" בהגדרות התוסף.
# BRIDGE_AUTH_TOKEN=

# Supabase Vault (אופציונלי - רק אם משתמשים ב-Supabase MCP)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# OAuth App Credentials (אופציונלי)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SUPABASE_CLIENT_ID=
# SUPABASE_CLIENT_SECRET=
