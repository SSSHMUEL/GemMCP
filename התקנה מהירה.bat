@echo off
chcp 65001 >nul
title התקנת GemMCP
echo ===================================================
echo ברוכים הבאים להתקנה המהירה של GemMCP!
echo ===================================================
echo.
echo מה עומד לקרות עכשיו:
echo 1. שרת הגישור (Bridge Server) יופעל כעת ברקע (חלון שחור נפרד שישאר פתוח).
echo 2. דפדפן Chrome ייפתח אוטומטית במסך התוספים.
echo.
echo מה שנשאר לך לעשות בדפדפן:
echo 1. להדליק את "מצב מפתח" (Developer Mode) בצד העליון.
echo 2. לגרור את התיקייה הזו לתוך חלון הדפדפן.
echo 3. להיכנס לג'מיני, לקלוד או ל-ChatGPT ולהתחיל לעבוד!
echo.
echo לחץ על מקש כלשהו כדי להתחיל...
pause >nul
echo.

REM רישום הפרוטוקול gemmcp:// - זה מה שמאפשר לתוסף להעיר את השרת בעצמו.
REM בלעדיו הכל עובד, חוץ מזה: כל פתיחה של ג'מיני דורשת הפעלה ידנית של
REM השרת, בלי שום הודעה שמסבירה למה. השורה הזו פשוט נשכחה כאן.
echo [1/3] רושם את פרוטוקול ההפעלה האוטומטית...
call "%~dp0register-protocol.bat" quiet

echo [2/3] מפעיל את שרת הגישור...
start "" "%~dp0start-bridge.bat"

echo [3/3] פותח את מסך התוספים של Chrome...
start chrome "chrome://extensions/"

echo.
echo ===================================================
echo הכל מוכן. נשאר רק לגרור את התיקייה לחלון התוספים.
echo ===================================================
echo.
pause
